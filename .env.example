# Google Identity Services token popup needs the OAuth 2.0 client ID of the
# "Web application" client created in the salat-calendar Google Cloud project.
# This value is public by design (it ships in the page); there is no client
# secret in this flow. Copy this file to .env.local and fill in your value.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public origin of the deployed site, used for absolute canonical and
# hreflang links. Defaults to http://localhost:3000 when unset.
SITE_URL=
